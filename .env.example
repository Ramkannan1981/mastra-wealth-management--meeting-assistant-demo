# Copy this file to .env and fill in ONE of the following, depending on
# which model provider you want to use. See README for details.

# Option A: Anthropic
ANTHROPIC_API_KEY=

# Option B: OpenAI
OPENAI_API_KEY=

# Optional: override the model used by the agent. Must be a
# "provider/model-name" string Mastra's model router supports.
# Model names change frequently -- check your provider's current docs.
# Default if unset: anthropic/claude-sonnet-4-5
MASTRA_MODEL=
